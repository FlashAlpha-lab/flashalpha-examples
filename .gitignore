*.svg
*.csv

# Environment / secrets — never commit API keys
.env
.env.*
*.env
.envrc

# Credential files (any name pattern that commonly holds secrets)
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
service-account.json
.netrc
_netrc

