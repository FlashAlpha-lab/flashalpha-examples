*.pfx
*.crt
*.cer
*.csr
*.pkcs12
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Common local-override files that hide secrets in dev environments
local_settings.py
settings.local.py
config.local.*
*.secret
*.secrets

